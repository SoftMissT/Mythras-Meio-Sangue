<div class="tab notes" data-group="primary" data-tab="notes">
  <h2>
    {{localize 'MYTHRAS.Journal'}}
  </h2>
  <div>
    <div class="desc" data-group="primary" data-tab="notes">
      {{#if editable}}
      <prose-mirror name="system.journal" button="true" editable="{{editable}}" toggled="false" value="{{system.journal}}">
        {{{journalHTML}}}
      </prose-mirror>
      {{else}}
      {{{journalHTML}}}
      {{/if}}
    </div>
  </div>
</div>